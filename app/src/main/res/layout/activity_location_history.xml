<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#1B2838"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="24s Konum Geçmişi"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="1x"
            android:textColor="#4FC3F7"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

    <!-- Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controlsPanel"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Controls Panel -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B2838"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Time and status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--:--"
                android:textColor="#4FC3F7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yükleniyor..."
                android:textColor="#78909C"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- SeekBar -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:progressTint="#4FC3F7"
            android:thumbTint="#4FC3F7" />

        <!-- Playback controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⏮"
                android:textSize="16sp"
                android:backgroundTint="#1B2838"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:text="▶"
                android:textSize="18sp"
                android:backgroundTint="#4CAF50"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:text="⏸"
                android:textSize="18sp"
                android:backgroundTint="#FF9800"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:text="⏹"
                android:textSize="18sp"
                android:backgroundTint="#F44336"
                android:textColor="@android:color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⏭"
                android:textSize="16sp"
                android:backgroundTint="#1B2838"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Speed row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hız: "
                android:textColor="#78909C"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn1x"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:text="1x"
                android:textSize="13sp"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn2x"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:text="2x"
                android:textSize="13sp"
                android:backgroundTint="#1B2838"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn4x"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:text="4x"
                android:textSize="13sp"
                android:backgroundTint="#1B2838"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>